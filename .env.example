APP_NAME="IR Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ir_lab
DB_USERNAME=ir_lab
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email ITPLN (Office 365) untuk kode reset password & verifikasi email.
# MAIL_FROM_ADDRESS harus sama dengan akun yang login (MAIL_USERNAME).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=irlab@itpln.ac.id
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="irlab@itpln.ac.id"
# MAIL_FROM_NAME="Lab IR ITPLN"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fitur Program (Workshop/Quick Tutor/Rekrutmen/Maintenance). false = "Belum tersedia".
LAB_PROGRAMS_ENABLED=false

# Akun Admin tetap (php artisan db:seed --class=AdminSeeder --force).
# ADMIN_PASSWORD kosong = dibuatkan acak & ditampilkan sekali. Wajib ganti saat login pertama.
ADMIN_NAME="Admin Lab IR"
ADMIN_EMAIL=
ADMIN_PASSWORD=
